{
  "name": "strix",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "build:icon": "node scripts/build-icon.mjs && iconutil -c icns build/icon.iconset -o build/icon.icns",
    "app": "concurrently -k -n next,electron \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "dist": "pnpm build:icon && NEXT_PUBLIC_SITE_URL=https://strixprep.com next build && node scripts/prepare-standalone.mjs && electron-builder --mac"
  },
  "build": {
    "appId": "com.strixprep.app",
    "productName": "Strix",
    "files": [
      "package.json",
      "electron/**/*",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    },
    "directories": {
      "output": "dist-app"
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.35.2",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
