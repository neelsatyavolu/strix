{
  "name": "strix",
  "version": "0.2.6",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test 'test/*.test.mjs'",
    "electron": "electron .",
    "build:icon": "node scripts/build-icon.mjs && iconutil -c icns build/icon.iconset -o build/icon.icns",
    "app": "concurrently -k -n next,electron \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "dist": "pnpm build:icon && electron-builder --mac --config electron-builder.config.cjs",
    "dist:signed": "bash scripts/dist.sh --sign",
    "dist:release": "bash scripts/dist.sh --apple"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "electron-updater": "^6.8.9",
    "katex": "^0.17.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.35.2",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
